generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id                 String         @id @default(cuid())
  name               String?
  email              String?        @unique
  emailVerified      DateTime?      @map("email_verified")
  image              String?
  role               UserRole       @default(CUSTOMER)
  needsRoleSelection Boolean        @default(true)
  bookings           Booking[]
  debts              CustomerDebt[]
  reviews            Review[]
  accounts           Account[]
  sessions           Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Barbershop {
  id             String              @id @default(uuid())
  name           String              @unique
  address        String
  phones         String[]
  description    String
  imageUrl       String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  services       BarbershopService[]
  fixedSchedules FixedSchedule[]
  reviews        Review[]
}

model BarbershopService {
  id           String     @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  price        Decimal    @db.Decimal(10, 2)
  barbershopId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  barbershop   Barbershop  @relation(fields: [barbershopId], references: [id])
  bookings     Booking[]
  bookingItems BookingService[]
}

model Booking {
  id                    String                 @id @default(uuid())
  userId                String?
  serviceId             String
  date                  DateTime
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                BookingStatus          @default(PENDING)

  clientName            String?
  clientPhone           String?

  reminderSent          Boolean                @default(false)
  reminderSentAt        DateTime?

  subtotal              Decimal                @default(0) @db.Decimal(10, 2)
  discount              Decimal                @default(0) @db.Decimal(10, 2)
  total                 Decimal                @default(0) @db.Decimal(10, 2)

  service               BarbershopService      @relation(fields: [serviceId], references: [id])
  bookingItems          BookingService[]

  user                  User?                  @relation(fields: [userId], references: [id])
  debts                 CustomerDebt[]
  financialTransactions FinancialTransaction[]

  @@index([date])
  @@index([reminderSent, date])
}

model BookingService {
  id        String   @id @default(uuid())
  bookingId String
  serviceId String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  booking Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service BarbershopService @relation(fields: [serviceId], references: [id])

  @@unique([bookingId, serviceId])
  @@index([bookingId])
  @@index([serviceId])
}

model FixedSchedule {
  id           String     @id @default(uuid())
  barbershopId String
  clientName   String
  dayOfWeek    Int
  time         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, dayOfWeek, time])
}

model CustomerDebt {
  id          String   @id @default(uuid())
  userId      String?
  bookingId   String?
  amount      Decimal  @db.Decimal(10, 2)
  type        DebtType
  description String?
  createdAt   DateTime @default(now())
  clientName  String?
  clientPhone String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  financialTransactions FinancialTransaction[]

  @@index([userId])
  @@index([bookingId])
}

model FinancialTransaction {
  id             String                   @id @default(uuid())
  amount         Decimal                  @db.Decimal(10, 2)
  type           FinancialTransactionType
  description    String?
  bookingId      String?
  customerDebtId String?
  clientName     String?
  clientPhone    String?
  createdAt      DateTime                 @default(now())

  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customerDebt CustomerDebt? @relation(fields: [customerDebtId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
  @@index([bookingId])
  @@index([customerDebtId])
}

model Review {
  id           String     @id @default(cuid())
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())
  userId       String
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
}

enum UserRole {
  CUSTOMER
  BARBER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum DebtType {
  DEBT
  PAYMENT
}

enum FinancialTransactionType {
  SERVICE_PAYMENT
  DEBT_PAYMENT
}
